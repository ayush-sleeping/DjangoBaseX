# Django backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only: the backend's address from the Next.js server. Unset outside Docker
# (falls back to NEXT_PUBLIC_API_URL); docker-compose.yml sets it to http://backend:8000.
# INTERNAL_API_URL=

# The auth cookie prefix. MUST equal the backend's AUTH_COOKIE_PREFIX (set explicitly, or derived
# from PRODUCT_SLUG). If they differ, the proxy never sees the session marker and signed-in users
# loop back to /login (NEXTJS_STANDARDS.md § 6). Unset = the shipped default.
# NEXT_PUBLIC_AUTH_COOKIE_PREFIX=

# Content-Security-Policy (FRONTEND_PLATFORM § 18), read by src/proxy.ts per request at runtime:
# flipping enforcement is a restart, never a rebuild. Roll out report_only first.
# CSP_MODE=report_only                     # off | report_only | enforce (unknown = report_only)
# CSP_EXTRA_ORIGINS=                       # comma-separated bare origins, added to img-src and connect-src
# CSP_REPORT_URL=/api/public/csp-report/   # unset = no report-uri / report-to

# Shared secret for POST /fe/revalidate/ (the backend calls it after a brand save so the change shows
# at once). Server-side only, read per request; unset = the route refuses every call. Use a long
# random value, and the same one on the backend once its caller lands (TECH_DEBT DB-90).
# REVALIDATE_SECRET=
