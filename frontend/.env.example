# Django backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only: the backend's address from the Next.js server. Unset outside Docker
# (falls back to NEXT_PUBLIC_API_URL); docker-compose.yml sets it to http://backend:8000.
# INTERNAL_API_URL=

# The auth cookie prefix. MUST equal the backend's AUTH_COOKIE_PREFIX (set explicitly, or derived
# from PRODUCT_SLUG). If they differ, the proxy never sees the session marker and signed-in users
# loop back to /login (NEXTJS_STANDARDS.md § 6). Unset = the shipped default.
# NEXT_PUBLIC_AUTH_COOKIE_PREFIX=
