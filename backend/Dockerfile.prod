# Release image for the Django API, worker and beat (OPERATIONS.md § 5): one image, process roles are
# commands. Build from the repository root, from a clean annotated tag:
#
#   docker build -f backend/Dockerfile.prod --build-arg APP_VERSION=1.4.0 \
#       --label org.opencontainers.image.version=1.4.0 --label org.opencontainers.image.revision=$(git rev-parse HEAD) \
#       -t "$IMAGE_PREFIX/backend:1.4.0" .
#
# Never built on a server. No migration here: migrate is an explicit deploy step (scripts/deploy.py).
# Runs gunicorn, which backend/pyproject.toml must list (TECH_DEBT DB-116): the build fails at
# `gunicorn --version` until it does, which is the point.

ARG PYTHON_IMAGE=python:3.12.12-slim

FROM ${PYTHON_IMAGE} AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy
WORKDIR /src
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
# collectstatic needs no secret: a throwaway development env, none of which reaches the runtime stage.
RUN APP_ENV=development SECRET_KEY=build-time-throwaway-not-a-secret-0123456789 \
    /opt/venv/bin/python manage.py collectstatic --noinput

FROM ${PYTHON_IMAGE} AS runtime
ARG APP_VERSION=0.0.0-dev
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_VERSION=${APP_VERSION}
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=10001:10001 /src /app
WORKDIR /app
USER 10001:10001
RUN gunicorn --version
EXPOSE 8000
# Readiness, not liveness: Docker's health gates the rolling swap, so it must mean "can serve".
# A Python one-liner: the slim image has no curl.
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=30s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/ready/', timeout=3)"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "30", "--graceful-timeout", "30", "--access-logfile", "-"]
