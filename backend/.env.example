# Copy to .env and adjust. Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/djangobasex
# DATABASE_URL=

# Next.js dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Shared cache. Unset = per-process LocMem, fine for one local runserver only. Throttles, lockout
# and session revocation live here, so anything with more than one process needs Redis.
# docker-compose.yml sets this to its own Redis service.
# CACHE_URL=redis://localhost:6379/0

# Proxies in front of the app (0 = trust REMOTE_ADDR). Wrong makes per-IP lockout global.
TRUSTED_PROXY_COUNT=0

# Mounts /admin/. Defaults to DEBUG.
# ADMIN_ENABLED=

# Email. Console backend prints mail to the terminal in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
# Where emailed links point — never taken from the request's Host header.
FRONTEND_BASE_URL=http://localhost:3000

# Signs auth JWTs (ADR-0009). REQUIRED, separate from SECRET_KEY, blank here on purpose. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Token lifetimes in seconds: access, refresh (absolute), refresh idle window.
# ACCESS_TOKEN_LIFETIME=600
# REFRESH_TOKEN_LIFETIME=1209600
# REFRESH_IDLE_LIFETIME=604800
# Two tabs refreshing together is ordinary use; 0 disables this and logs people out.
# REFRESH_ROTATION_GRACE=15
# How long "is this session still live" is cached. 0 = checked on every request.
# SESSION_LIVENESS_CACHE_TTL=60
# Auth cookies. Secure defaults to `not DEBUG`; never set it False in production.
# AUTH_COOKIE_SECURE=
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_PREFIX=dbx

# Progressive lockout: THRESHOLD failures within WINDOW seconds lock the address (×5 for an IP)
# for DURATION seconds, doubling for each further lock in 24h.
# LOCKOUT_THRESHOLD=10
# LOCKOUT_WINDOW=900
# LOCKOUT_DURATION=900
# Password-reset link lifetime in seconds. A link works once.
# PASSWORD_RESET_TOKEN_LIFETIME=1800
# An operator-created account's set-your-password link, and an invitation, in seconds.
# PASSWORD_SETUP_TOKEN_LIFETIME=259200
# INVITATION_LIFETIME=604800

# Rotating JWT_SIGNING_KEY without logging everyone out: move the old key here (comma-separated),
# deploy, wait REFRESH_TOKEN_LIFETIME, then remove it. Verify-only; nothing new is signed with it.
# JWT_SIGNING_KEY_FALLBACKS=
# Past this many live sessions, a new sign-in revokes the user's oldest.
# MAX_SESSIONS_PER_USER=10
# Retention for `manage.py auth_cleanup` (run it from cron). The audit log is never pruned by it.
# LOGIN_ATTEMPT_RETENTION_DAYS=90
# SESSION_RETENTION_DAYS=30
# PASSWORD_RESET_TOKEN_RETENTION_DAYS=7

# Two-factor (TOTP). A Fernet key encrypting secrets at rest; blank = MFA setup answers 503. Generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# The name authenticator apps show for this product.
# MFA_ISSUER=DjangoBaseX
# MFA_TOKEN_LIFETIME=300
# Re-authentication is OFF until actions are listed (comma-separated), e.g. mfa_disable.
# REAUTH_ACTIONS=
# REAUTH_WINDOW_MINUTES=15
