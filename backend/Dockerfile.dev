# Development image for the Django API — used by docker-compose.yml only.
# Source is bind-mounted at /app and runserver reloads on save. Not a release image
# (OPERATIONS.md § 5): no gunicorn, dev dependencies included, DEBUG comes from backend/.env.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

# The virtualenv lives outside /app, so the bind mount (and the host's macOS .venv in it) never
# shadows the Linux one.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/tmp/uv-cache

RUN useradd --uid 1000 --create-home app \
    && mkdir -p /app /opt/venv \
    && chown app:app /app /opt/venv
USER app
WORKDIR /app

COPY --chown=app:app pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen

EXPOSE 8000
